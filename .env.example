# Copy this file to .env and fill in the values.
# The database and redis defaults match docker-compose.yml and work as-is.

# Database
DATABASE_URL="postgresql://jobtracker:jobtracker@127.0.0.1:5432/jobtracker?schema=public"

# Cache and rate limiting (used from M06)
REDIS_URL="redis://127.0.0.1:6379"

# Session signing secret (used from M02)
JWT_SECRET=""

# Public base URL, used for OAuth callbacks and email links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OAuth providers (used from M03)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Transactional email (used from M07)
RESEND_API_KEY=""

# Shared secret protecting the reminder endpoint (used from M07)
CRON_SECRET=""
