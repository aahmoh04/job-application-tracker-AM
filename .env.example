# Copy this file to .env and fill in the values.
# The database and redis defaults match docker-compose.yml and work as-is.

# Database
DATABASE_URL="postgresql://jobtracker:jobtracker@127.0.0.1:5432/jobtracker?schema=public"

# Rate limits on sign-in and sign-up, and the analytics cache. Without it the
# limits switch themselves off and the analytics are read straight from Postgres.
REDIS_URL="redis://127.0.0.1:6379"

# Session signing secret (used from M02)
JWT_SECRET=""

# Public base URL, used for OAuth callbacks and email links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# GitHub OAuth (used from M03)
# Create an app at github.com/settings/developers with the callback URL
# http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Reminder mails. MAIL_FROM is the sender address. Locally every mail goes to
# Mailpit from docker-compose.yml, readable at http://localhost:8025. With
# RESEND_API_KEY set, mail goes out through Resend instead.
MAIL_FROM="reminders@jobtracker.localhost"
MAILPIT_URL="http://127.0.0.1:8025"
RESEND_API_KEY=""

# Protects the reminder job at /api/cron/reminders. Vercel Cron sends it as a
# bearer token. Locally any long random string works, see the README.
CRON_SECRET=""
